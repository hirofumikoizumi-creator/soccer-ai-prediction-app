{
  "expo": {
    "name": "サッカーAI予想シミュレーション",
    "slug": "soccer-ai-prediction",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "socceraiprediction",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTabletMode": false,
      "bundleIdentifier": "com.gsw.socceraiyosou",
      "buildNumber": "2",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "カメラを使用してスタメン画像を撮影します",
        "NSPhotoLibraryUsageDescription": "フォトライブラリからスタメン画像を選択します",
        "NSPhotoLibraryAddUsageDescription": "スタメン画像をフォトライブラリに保存します",
        "SKAdNetworkItems": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#003DA5",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "フォトライブラリへのアクセスを許可してください",
          "cameraPermission": "カメラへのアクセスを許可してください"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#003DA5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "appId": "ca-app-pub-xxxxxxxxxxxxxxxx"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e85941a6-99fb-4545-a2d7-ee8e669aea36"
      }
    },
    "owner": "hirofumikoizumi"
  }
}
